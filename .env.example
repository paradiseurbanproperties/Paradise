# Copia este archivo a .env.local y reemplaza los marcadores con los valores del proyecto.
# La clave publishable es apta para el cliente; la seguridad de datos depende de RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Mapas: MapLibre consume teselas configurables; no se descargan áreas en lote.
NEXT_PUBLIC_MAP_STYLE_URL=<map-style-url>
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Geocodificación solo por acción explícita del usuario. Nunca autocompletar con Nominatim público.
GEOCODING_PROVIDER=<provider>
GEOCODING_API_KEY=<server-side-key-if-required>

# Origen público para metadatos, enlaces y callbacks de autenticación; añadirlo a las Redirect URLs de Supabase Auth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
